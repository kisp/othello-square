+
+(defun navbar (initial-vnode)
+  (plist2object
+   (list
+    :view
+    (lambda (vnode)
+      (m "header"
+         (list :class "text-white text-xl md:text-2xl bg-pink-700 p-2 shadow-lg flex items-center")
+         (m "h1" (m "a" (list :href "/") "Othello Square")))))))
+
+(defun mybutton (initial-vnode)
+  (plist2object
+   (list
+    :view
+    (lambda (vnode)
+      (m "div.p-8"
+         (m "button"
+            (if (jscl::oget vnode "attrs" "green")
+                (list
+                 :class "p-8 bg-green-500")
+                (list
+                 :class "text-4xl bg-pink-100 border p-8 border-8 border-pink-500 rounded-full hover:bg-green-500"
+                 :onclick (lambda (event) (clog event))))
+            (ecase (jscl::oget vnode "attrs" "green")
+              (:foo (princ-to-string (jscl::oget vnode "attrs" "text")))
+              (:bar (princ-to-string :bar))
+              (:xxx (princ-to-string :xxx)))))))))
+
+(defun wrapper (initial-vnode)
+  (plist2object
+   (list
+    :view
+    (lambda (vnode)
+      (m "div"
+         (list :class "border-2 border-black")
+         (jscl::oget vnode "children"))))))
+
+(defvar comp-with-hooks
+  (plist2object
+   (list :oninit (lambda (vnode) (clog::clog "DOM created"))
+         :view (lambda (vnode)
+                 (clog::clog "view called")
+                 (m "div" (list :onclick (lambda (event))) "hello")))))
+
+(defun counter (initial-vnode)
+  (let ((count 10))
+    (clog "COUNTER CONSTRUCTOR CALLED")
+    (plist2object
+     (list
+      :oninit (lambda (vnode) (clog::clog "init counter component"))
+      :onremove (lambda (vnode) (clog::clog "remove counter component"))
+      :onbeforeupdate (lambda (vnode old)
+                        (clog::clog "ONBEFOREUPDATE")
+                        (clog::clog old)
+                        (clog::clog vnode)
+                        t)
+      :view
+      (lambda (vnode)
+        (clog::clog "VIEW CALLED")
+        (m "div.text-8xl.p-8.m-8.border-2"
+           (m "div" count)
+           (m "button.border.bg-blue-500.rounded-full.hover:bg-blue-600"
+              (list :onclick (lambda (event) (incf count) (clog::clog-lisp count)))
+              "1+")))))))
